'use strict';
const test = require('node:test');
const assert = require('node:assert');
const P = require('../../public/golf/physics');

// Un rettangolo di prato 20 x 6 con le sponde sui bordi
const box = (extra = {}) => ({
  name: 'Prova',
  par: 2,
  start: [1, 3],
  cup: [18, 3],
  floor: [[0, 0], [20, 0], [20, 6], [0, 6]],
  ...extra,
});

function roll(ball, hole, maxT = 20, t0 = 0) {
  let t = t0;
  while (t < t0 + maxT) {
    const ev = P.step(ball, hole, P.DT, t);
    t += P.DT;
    if (ev) return { ev, t };
    if (P.atRest(ball)) return { ev: null, t };
  }
  return { ev: 'timeout', t };
}

test('sul prato la pallina rallenta e si ferma; più forza = più strada', () => {
  const hole = box({ cup: [19.5, 5.5] });
  const soft = P.createBall(1, 3);
  P.shoot(soft, 0, 0.3);
  assert.strictEqual(roll(soft, hole).ev, null);
  const hard = P.createBall(1, 3);
  P.shoot(hard, 0, 0.5);
  roll(hard, hole);
  assert.ok(soft.x > 1.5, 'si è mossa');
  assert.ok(hard.x > soft.x, 'più forte va più lontano');
});

test('la sponda fa rimbalzare la pallina', () => {
  const hole = box({ cup: [10, 5.5] });
  const b = P.createBall(18, 3);
  P.shoot(b, 0, 0.6); // verso la sponda a x = 20
  let max = 0;
  let bounced = false;
  for (let i = 0; i < 400; i++) {
    P.step(b, hole, P.DT, 0);
    max = Math.max(max, b.x);
    if (b.vx < 0) bounced = true;
  }
  assert.ok(bounced, 'torna indietro');
  assert.ok(max <= 20 - P.BALL_R + 1e-6, 'non attraversa la sponda');
});

test('in buca se arriva piano, scavalca se arriva troppo forte', () => {
  const hole = box();
  const slow = P.createBall(15, 3);
  P.shoot(slow, 0, 0.35);
  assert.strictEqual(roll(slow, hole).ev, 'sunk');

  const fast = P.createBall(16, 3);
  P.shoot(fast, 0, 1);
  // il primo passaggio sopra la buca non la fa entrare
  let sunkFirstPass = false;
  for (let i = 0; i < 60; i++) {
    if (P.step(fast, hole, P.DT, 0) === 'sunk') sunkFirstPass = true;
  }
  assert.strictEqual(sunkFirstPass, false);
});

test('la sabbia frena molto più del prato', () => {
  const grass = box({ cup: [19.5, 5.5] });
  const sand = box({ cup: [19.5, 5.5], zones: [{ type: 'sand', poly: [[0, 0], [20, 0], [20, 6], [0, 6]] }] });
  const a = P.createBall(1, 3);
  P.shoot(a, 0, 0.4);
  roll(a, grass);
  const b = P.createBall(1, 3);
  P.shoot(b, 0, 0.4);
  roll(b, sand);
  assert.ok(b.x - 1 < (a.x - 1) / 2);
});

test("nell'acqua la pallina finisce fuori", () => {
  const hole = box({ zones: [{ type: 'water', poly: [[5, 0], [7, 0], [7, 6], [5, 6]] }] });
  const b = P.createBall(1, 3);
  P.shoot(b, 0, 0.7);
  assert.strictEqual(roll(b, hole).ev, 'water');
});

test('sulla rampa la pallina ferma scende da sola', () => {
  // rampa che sale da x=5 (altezza 0) a x=15 (altezza 1)
  const hole = box({ cup: [19.5, 5.5], ramps: [{ poly: [[5, 0], [15, 0], [15, 6], [5, 6]], from: [5, 0], to: [15, 1] }] });
  assert.ok(Math.abs(P.heightAt(hole, 10, 3) - 0.5) < 1e-9);
  const b = P.createBall(10, 3);
  roll(b, hole);
  assert.ok(b.x < 10, 'è scivolata verso il basso');
});

test('un tiro debole non sale la rampa, uno forte sì', () => {
  const hole = box({ cup: [19.5, 5.5], ramps: [{ poly: [[5, 0], [15, 0], [15, 6], [5, 6]], from: [5, 0], to: [15, 1] }] });
  const weak = P.createBall(1, 3);
  P.shoot(weak, 0, 0.35);
  roll(weak, hole);
  assert.ok(weak.x < 15);
  const strong = P.createBall(1, 3);
  P.shoot(strong, 0, 1);
  roll(strong, hole);
  assert.ok(strong.x > 15);
});

test('il respingente rimbalza la pallina', () => {
  const hole = box({ cup: [19.5, 5.5], bumpers: [{ x: 6, z: 3, r: 0.5 }] });
  const b = P.createBall(1, 3);
  P.shoot(b, 0, 0.6);
  let back = false;
  for (let i = 0; i < 600 && !back; i++) {
    P.step(b, hole, P.DT, 0);
    if (b.vx < 0) back = true;
    assert.ok(Math.hypot(b.x - 6, b.z - 3) >= 0.5 + P.BALL_R - 1e-6);
  }
  assert.ok(back);
});

test('il mulinello che gira blocca la pallina quando è di traverso', () => {
  // asta lunga 6 al centro: all'istante 0 è verticale (angolo 90°), cioè di traverso al tiro
  const hole = box({ cup: [19.5, 5.5], spinners: [{ x: 10, z: 3, len: 6, speed: 0, angle: Math.PI / 2 }] });
  const b = P.createBall(1, 3);
  P.shoot(b, 0, 0.8);
  roll(b, hole, 20, 0);
  assert.ok(b.x < 10);
  const pos = P.spinnerSegment(hole.spinners[0], 0);
  assert.ok(Math.abs(pos[0] - 10) < 1e-9 && Math.abs(pos[2] - 10) < 1e-9, 'verticale');
});

test('la simulazione è uguale per tutti: stessi tiri, stesso risultato', () => {
  const hole = box({ cup: [19.5, 5.5], bumpers: [{ x: 8, z: 2, r: 0.4 }] });
  const a = P.createBall(1, 3);
  const b = P.createBall(1, 3);
  P.shoot(a, 0.2, 0.8);
  P.shoot(b, 0.2, 0.8);
  roll(a, hole);
  roll(b, hole);
  assert.deepStrictEqual(a, b);
});
